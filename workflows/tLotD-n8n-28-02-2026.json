    {
      "parameters": {
        "jsCode": "// n8n splits array responses into individual items.\n// $input.all() returns all items - each one is a pod object.\nconst items = $input.all();\n\n// Case 1: n8n split the array - each item.json is a pod object\nconst activePod = items.find(item =>\n  item.json.name === 'tLotD-comfy' && item.json.desiredStatus === 'RUNNING'\n);\n\nif (activePod) {\n  return [{ json: { found: true, id: activePod.json.id } }];\n}\n\n// Case 2: response came wrapped as { data: [...] } in a single item\nfor (const item of items) {\n  if (item.json.data && Array.isArray(item.json.data)) {\n    const pod = item.json.data.find(p =>\n      p.name === 'tLotD-comfy' && p.desiredStatus === 'RUNNING'\n    );\n    if (pod) {\n      return [{ json: { found: true, id: pod.id } }];\n    }\n  }\n}\n\nreturn [{ json: { found: false, id: null } }];"
      },
