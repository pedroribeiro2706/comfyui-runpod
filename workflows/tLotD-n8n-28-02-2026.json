    {
      "parameters": {
        "jsCode": "const webhook = $('Webhook').first().json;\nconst prompt = webhook.body.prompt || '';\nconst negativePrompt = webhook.body.negative_prompt || 'deformed, ugly, low quality, blurry, watermark, extra limbs, extra fingers, malformed hands, lowres, bad anatomy, missing limbs, floating limbs';\nconst seed = Math.floor(Math.random() * 9999999999);\n\nconst payload = {\n  prompt: {\n    '1': {\n      inputs: { ckpt_name: 'DreamShaperXL_Turbo_dpmppSdeKarras_half_pruned_6.safetensors' },\n      class_type: 'CheckpointLoaderSimple'\n    },\n    '2': {\n      inputs: {\n        text: 'masterpiece, best quality, highly detailed, concept art, ' + prompt,\n        clip: ['1', 1]\n      },\n      class_type: 'CLIPTextEncode'\n    },\n    '8': {\n      inputs: {\n        text: negativePrompt,\n        clip: ['1', 1]\n      },\n      class_type: 'CLIPTextEncode'\n    },\n    '4': {\n      inputs: { width: 1024, height: 1024, batch_size: 1 },\n      class_type: 'EmptyLatentImage'\n    },\n    '3': {\n      inputs: {\n        seed: seed,\n        steps: 28,\n        cfg: 6,\n        sampler_name: 'euler_ancestral',\n        scheduler: 'karras',\n        denoise: 1,\n        model: ['1', 0],\n        positive: ['2', 0],\n        negative: ['8', 0],\n        latent_image: ['4', 0]\n      },\n      class_type: 'KSampler'\n    },\n    '6': {\n      inputs: { samples: ['3', 0], vae: ['1', 2] },\n      class_type: 'VAEDecode'\n    },\n    '7': {\n      inputs: { filename_prefix: 'tLotD', images: ['6', 0] },\n      class_type: 'SaveImage'\n    }\n  }\n};\n\nreturn [{ json: { payload: JSON.stringify(payload), seed: seed } }];"
      },
